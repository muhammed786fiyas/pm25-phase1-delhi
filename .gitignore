# ---- secrets ----
.env
.env.local
*.key

# ---- bulk downloaded data (DVC-tracked; DVC manages ignoring the real files) ----
# NOTE: data/raw, data/interim, data/processed are tracked via DVC.
# Their .dvc pointer files ARE version controlled — only the real data is ignored,
# and DVC adds those specific ignore rules automatically on `dvc add`.

*.csv.gz
*.parquet

# ---- station metadata: deliberately NOT ignored ----
# Small, manually-QC'd CSVs that can't be regenerated automatically.
# Tracked directly in git, not through DVC. See data/stations/.

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# ---- environments ----
.venv/
venv/
env/

# ---- editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
test.py


# ---- MLflow local tracking store ----
# MLFLOW_TRACKING_URI (.env) points here. This is MLflow's own run/artifact
# store (grows with every run -- metrics, params, and copies of logged
# artifacts like the model pickle for each run), not a versioned deliverable.
# Separate from models/lme/ (the actual fitted-model output, DVC-tracked).
models/mlflow_tracking/
